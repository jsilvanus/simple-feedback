# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins. Leave unset to allow all in development.
# In production, set this to your actual frontend URL(s).
# CORS_ORIGIN=https://feedback.example.com,https://www.example.com

# Database Configuration (match docker-compose defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=simple_feedback
DB_USER=postgres
DB_PASSWORD=postgres

# Authentication Configuration
# AUTH_MODE=dev (default): local admin credentials with ADMIN_USERNAME and ADMIN_PASSWORD
# AUTH_MODE=oidc: OpenID Connect authentication via Tunnus or compatible provider
AUTH_MODE=dev

# OIDC / Tunnus Configuration (required when AUTH_MODE=oidc)
# OIDC_ISSUER=https://id.riihimaenseurakunta.fi/tunnus
# OIDC_CLIENT_ID=simple-feedback
# OIDC_CLIENT_SECRET=your-oidc-client-secret
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
# OIDC_SCOPES=openid profile email groups
# OIDC_BUTTON_LABEL=Kirjaudu Tunnuksella
# ALLOW_LOCAL_ADMIN=false

# Group to Role Mapping (JSON string)
# Maps claims.groups array to application roles ('admin', 'manager', 'viewer')
# OIDC_GROUP_ROLE_MAP={"/feedback-admins":"admin","/feedback-managers":"manager","admin":"admin"}

# Session & Base URL
# BASE_URL=http://localhost:3000
# SESSION_SECRET=your-super-secret-session-key-change-in-production

# JWT Configuration
# REQUIRED: Use a strong random value (at least 32 chars) in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Admin Credentials
# Change these before deploying to production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Image Storage Configuration
# STORAGE_DRIVER=local (default): images are written to STORAGE_LOCAL_DIR on local disk.
# STORAGE_DRIVER=s3: images are written to an S3-compatible bucket (e.g. MinIO).
# In both cases images are served back through the app via GET /api/images/:filename.
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./uploads

# S3 / MinIO Configuration (required only when STORAGE_DRIVER=s3)
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_BUCKET=simple-feedback-images
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_FORCE_PATH_STYLE=true

# Brevo API Configuration (for email and SMS notifications)
# Get your API key from https://app.brevo.com/settings/keys/api
# Optional: only required if using email or SMS notifications
# BREVO_API_KEY=your-brevo-api-key

# Reverse proxy: set when the app runs behind nginx or another proxy, so rate limits use the client
# address (Express `trust proxy`: a hop count such as 1, true, or addresses/subnets).
# TRUST_PROXY=1
